{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions: the core defaults plus dragging the window by the toolbar. App commands are registered in lib.rs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
