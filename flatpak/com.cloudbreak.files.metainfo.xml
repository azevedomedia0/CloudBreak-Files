<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for Flatpak / Flathub. Keep the id in sync with tauri.conf.json identifier. -->
<component type="desktop-application">
  <id>com.cloudbreak.files</id>
  <launchable type="desktop-id">com.cloudbreak.files.desktop</launchable>
  <name>Cloudbreak Files</name>
  <developer id="com.cloudbreak">
    <name>Steven Azevedo</name>
  </developer>
  <summary>Multi-cloud files with a private vault and P2P libraries</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <url type="homepage">https://azevedomedia0.github.io/CloudBreak-Files/</url>
  <url type="bugtracker">https://github.com/azevedomedia0/CloudBreak-Files/issues</url>
  <url type="vcs-browser">https://github.com/azevedomedia0/CloudBreak-Files</url>
  <content_rating type="oars-1.1" />
  <categories>
    <category>Utility</category>
    <category>FileTools</category>
    <category>Network</category>
  </categories>
  <keywords>
    <keyword>files</keyword>
    <keyword>cloud</keyword>
    <keyword>vault</keyword>
    <keyword>encryption</keyword>
    <keyword>p2p</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#0ea5e9</color>
    <color type="primary" scheme_preference="dark">#38bdf8</color>
  </branding>
  <recommends>
    <display_length compare="ge">960</display_length>
  </recommends>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <description>
    <p>
      Cloudbreak Files brings cloud accounts, local folders, and private peer-to-peer
      libraries into one desktop browser. Unlock a client-side encrypted vault, edit
      photos and trim video, and keep provider credentials in the OS keyring.
    </p>
    <ul>
      <li>Local Files with Trash-safe deletes and in-place saves</li>
      <li>Google Drive, Dropbox, OneDrive, MEGA, and Nextcloud</li>
      <li>AES-256-GCM vault with PBKDF2 passphrase protection</li>
      <li>Encrypted P2P libraries and invite links</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://azevedomedia0.github.io/CloudBreak-Files/assets/icon.png</image>
      <caption>Cloudbreak Files app icon</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.5" date="2026-10-10">
      <description>
        <p>
          Applications browse stays responsive with real app icons, PDFs open in the
          document viewer, Graphite sidebar polish, and a wider icon-size range.
        </p>
      </description>
    </release>
    <release version="0.1.4" date="2026-10-10">
      <description>
        <p>Faster startup with Desktop-first local scans and in-app update checks.</p>
      </description>
    </release>
    <release version="0.1.3" date="2026-10-09">
      <description>
        <p>Linux Flatpak packaging, appearance themes, folder context menus, and navigation history.</p>
      </description>
    </release>
  </releases>
  <update_contact>stevenazevedodesign@gmail.com</update_contact>
</component>
